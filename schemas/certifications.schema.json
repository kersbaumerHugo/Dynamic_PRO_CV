{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certifications",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "issuer", "year"],
    "properties": {
      "id": { "type": "string" },
      "name": {
        "type": "object",
        "properties": { "en": { "type": "string" }, "pt-BR": { "type": "string" } },
        "required": ["en", "pt-BR"]
      },
      "issuer": { "type": "string" },
      "year": { "type": "string", "pattern": "^\\d{4}$" },
      "credentialUrl": { "type": "string", "format": "uri" }
    }
  }
}
