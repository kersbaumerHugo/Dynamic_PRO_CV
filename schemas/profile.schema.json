{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "type": "object",
  "required": ["id", "slug", "title"],
  "properties": {
    "id": { "type": "string" },
    "enabled": { "type": "boolean" },
    "slug": { "type": "string" },
    "title": {
      "type": "object",
      "properties": { "en": { "type": "string" }, "pt-BR": { "type": "string" } },
      "required": ["en", "pt-BR"]
    },
    "summaryId": { "type": "string" },
    "featuredSkillIds": { "type": "array", "items": { "type": "string" } },
    "featuredProjectIds": { "type": "array", "items": { "type": "string" } },
    "includeTraining": { "type": "boolean" },
    "maxProjects": { "type": "integer" }
  }
}
