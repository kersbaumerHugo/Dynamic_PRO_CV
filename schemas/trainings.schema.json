{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trainings",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "institution"],
    "properties": {
      "id": { "type": "string" },
      "title": {
        "type": "object",
        "properties": { "en": { "type": "string" }, "pt-BR": { "type": "string" } },
        "required": ["en", "pt-BR"]
      },
      "institution": { "type": "string" },
      "year": { "type": "string", "pattern": "^\\d{4}$" },
      "link": { "type": "string", "format": "uri" }
    }
  }
}
