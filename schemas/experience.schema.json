{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experience",
  "type": "object",
  "required": ["id", "company", "role", "startDate"],
  "properties": {
    "id": { "type": "string" },
    "company": { "type": "string" },
    "role": {
      "type": "object",
      "properties": { "en": { "type": "string" }, "pt-BR": { "type": "string" } }
    },
    "location": { "type": "object" },
    "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "endDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
    "current": { "type": "boolean" },
    "bullets": { "type": "array" }
  }
}
