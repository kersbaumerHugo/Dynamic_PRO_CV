{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Links",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "url", "label"],
    "properties": {
      "id": { "type": "string" },
      "type": { "type": "string" },
      "url": { "type": "string", "format": "uri" },
      "label": {
        "type": "object",
        "properties": { "en": { "type": "string" }, "pt-BR": { "type": "string" } },
        "required": ["en", "pt-BR"]
      }
    }
  }
}
