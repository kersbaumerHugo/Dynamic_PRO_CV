<h2>Professional Experience</h2>
{% if experiences and experiences.length %}
  {% for e in experiences %}
    <article class="job">
      <h3>{{ e.role }} — {{ e.company }}</h3>
      <div class="dates">{{ e.startDate }} — {{ e.endDate or 'Present' }}</div>
      <ul>
      {% for b in e.bullets %}
        <li>{{ b.text and (b.text[locale] or b.text) or b }}</li>
      {% endfor %}
      </ul>
    </article>
  {% endfor %}
{% else %}
  <p>No experience entries.</p>
{% endif %}
